{
  "name": "ovk",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/sync-font-assets.mjs && npm run validate",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "node scripts/sync-font-assets.mjs && npm run validate",
    "build": "docusaurus build",
    "validate": "node scripts/validate-image-assets.mjs && node scripts/validate-identifier-config.mjs",
    "check": "npm run validate && npm run build && npm run validate:seo",
    "validate:seo": "node scripts/validate-seo.mjs",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "node scripts/serve-build.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-pwa": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource/inter": "5.3.0",
    "@mdx-js/react": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.1",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.2"
  }
